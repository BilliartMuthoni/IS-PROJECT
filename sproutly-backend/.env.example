APP_NAME=Sproutly
APP_ENV=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATABASE_URL=

# Browser origins allowed to call the API (JSON list). Default: the admin app dev server.
CORS_ORIGINS=["http://localhost:5173"]

# Trained model from Google Drive: CropDiseaseDiagnosis/models/image_baseline/model.pt
# (not in Git). Path is relative to sproutly-backend/.
ML_MODEL_PATH=models/image_baseline/model.pt
# Below this confidence the farmer is referred instead of diagnosed (never below 0.5).
CONFIDENCE_THRESHOLD=0.90

UPLOAD_DIR=uploads

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Encrypts each user's authenticator secret in the database. Changing it locks
# every user out of MFA, so set it once and keep it out of Git.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
# Name shown next to the codes in Google Authenticator / Microsoft Authenticator.
TOTP_ISSUER=Sproutly
# How long the app has between the password step and the code step.
MFA_TOKEN_EXPIRE_MINUTES=5
MFA_SETUP_TOKEN_EXPIRE_MINUTES=10