APP_NAME=Sproutly
APP_ENV=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATABASE_URL=

ML_MODEL_PATH=

UPLOAD_DIR=uploads

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# Email OTP delivery.
# For Gmail, SMTP_PASSWORD must be an App Password (requires 2FA):
# https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Sproutly